<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">

<head>
	<title>Mutxamel Club de Fútbol</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<link th:href="@{/css/estilos.css}" rel="stylesheet">
	<link rel="icon" href="/images/favicon.ico" type="image/x-icon">
	<link href="https://fonts.googleapis.com/css2?family=Fredericka+the+Great&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css">
</head>

<body>

	<!-- Incluir el header -->
	<div th:replace="~{cabecera.html}"></div>

	<div class="container mt-5 lead">
		<h2 class="text-center">Calendario / Resultados</h2>

		<!-- Formulario para actualizar resultados -->
		<form method="post" th:action="@{/admin/calendario-resultados/actualizar}">
			<table>
				<thead>
					<tr>
						<th>CATEGORÍA</th>
						<th>RESULTADO</th>
						<th>RIVAL</th>
						<th>DÍA</th>
						<th>HORA</th>
						<th>CAMPO</th>
						<th>ACCIONES</th>
					</tr>
				</thead>
				<tbody>
					<!-- Iteramos sobre la lista de resultados -->
					<tr th:each="resultado, iterStat : ${resultados}">
						<td>
							<input type="text" th:value="${resultado.categoria}"
								name="resultados[__${iterStat.index}__].categoria" readonly class="form-control" />
						</td>
						<td>
							<input type="text" th:value="${resultado.resultado}"
								name="resultados[__${iterStat.index}__].resultado" class="form-control" />
						</td>
						<td>
							<input type="text" th:value="${resultado.rival}"
								name="resultados[__${iterStat.index}__].rival" class="form-control" />
						</td>
						<td>
							<input type="date" th:value="${#dates.format(resultado.dia, 'dd/MM/yyyy')}"
								name="resultados[__${iterStat.index}__].dia" class="form-control" />
						</td>
						<td>
							<input type="text" th:value="${resultado.hora}"
								name="resultados[__${iterStat.index}__].hora" class="form-control" />
						</td>
						<td>
							<input type="text" th:value="${resultado.campo}"
								name="resultados[__${iterStat.index}__].campo" class="form-control" />
						</td>
						<td>
							<!-- Botón para actualizar cada registro -->
							<button type="submit"
								th:formaction="@{/admin/calendario-resultados/actualizar/{categoria}(categoria=${resultado.categoria})}"
								class="btn btn-primary">Actualizar</button>
						</td>
					</tr>
				</tbody>
			</table>

			<!--			 Botón para enviar el formulario -->
			<!--			<div class="text-center mt-3">-->
			<!--				<button type="submit" class="btn btn-primary">Actualizar</button>-->
			<!--			</div>-->
		</form>
	</div>

	<!-- Incluir el footer -->
	<div th:replace="~{footer.html}"></div>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>