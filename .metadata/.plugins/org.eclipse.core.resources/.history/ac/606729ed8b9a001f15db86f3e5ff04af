	<h1 class="text-center mt-5">Calendario / Resultados Fútbol</h1>

	<form method="post" action="/admin/calendario-resultados/actualizar">
		<table>
			<thead>
				<tr>
					<th style="display: none;">CATEGORIA</th>
					<th>EQUIPO</th>
					<th>RESULTADO</th>
					<th>RIVAL</th>
					<th>DÍA</th>
					<th>HORA</th>
					<th>CAMPO</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				<!-- Iteramos sobre la lista de resultados -->
				<tr th:each="resultado, iterStat : ${resultadosFutbol}">
					<form th:action="@{/admin/calendario-resultados/actualizar/{equipo}(equipo=${resultado.equipo})}"
