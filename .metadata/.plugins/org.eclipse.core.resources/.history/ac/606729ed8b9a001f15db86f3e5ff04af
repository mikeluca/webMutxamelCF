						<input type="hidden" th:name="${_csrf.parameterName}" th:value="${_csrf.token}" />
						<td style="display: none;">
							<input type="text" th:value="${resultado.categoria}" name="categoria"
								class="form-control" />
						</td>
						<td>
							<input type="text" th:value="${resultado.equipo}" name="equipo" readonly
								class="form-control" />
						</td>
						<td>
							<input type="text" th:value="${resultado.resultado}" name="resultado"
								class="form-control" />
						</td>
						<td>
							<input type="text" th:value="${resultado.rival}" name="rival" class="form-control" />
						</td>
						<td>
							<input type="text" th:value="${resultado.diaFormateado}" name="dia" class="form-control" />
						</td>
						<td>
							<input type="text" th:value="${resultado.hora}" name="hora" class="form-control" />
						</td>
						<td>
							<input type="text" th:value="${resultado.campo}" name="campo" class="form-control" />
						</td>
						<td>
							<button type="submit" class="btn btn-primary">Actualizar</button>
						</td>
					</form>
				</tr>
			</tbody>
		</table>
	</form>

