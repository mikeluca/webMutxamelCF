	<script>
		function actualizarResultado(equipo) {
			// Obtener los valores de cada campo en la fila del equipo
			const formData = new FormData();
			formData.append("categoria", document.getElementById(`categoria_${equipo}`).value);
			formData.append("equipo", equipo);
			formData.append("resultado", document.getElementById(`resultado_${equipo}`).value);
			formData.append("rival", document.getElementById(`rival_${equipo}`).value);
			formData.append("dia", document.getElementById(`dia_${equipo}`).value);
			formData.append("hora", document.getElementById(`hora_${equipo}`).value);
			formData.append("campo", document.getElementById(`campo_${equipo}`).value);

			// Enviar la solicitud AJAX
			fetch(`/admin/calendario-resultados/actualizar/${equipo}`, {
				method: 'POST',
				body: formData
			})
				.then(response => response.text())
				.then(data => {
					// Mostrar el mensaje en pantalla
					const mensajeContainer = document.getElementById("mensajeContainer");
					mensajeContainer.textContent = data;
					mensajeContainer.className = data.includes('Error') ? 'alert alert-danger' : 'alert alert-success';
					mensajeContainer.style.display = 'block';

					// Ocultar el mensaje después de unos segundos
					setTimeout(() => {
						mensajeContainer.style.display = 'none';
					}, 5000);
				})
				.catch(error => {
					console.error("Error:", error);
				});
		}
	</script>
