@Configuration
@EnableWebSecurity
public class SecurityConfig extends WebSecurityConfigurerAdapter {

	@Override
	protected void configure(HttpSecurity http) throws Exception {
		http.authorizeRequests().antMatchers("/hidden-menu").authenticated() // Solo usuarios autenticados
				.anyRequest().permitAll().and().formLogin() // Habilita el formulario de inicio de sesión
				.loginPage("/login") // Ruta para el formulario de login
				.permitAll().and().logout().permitAll();
	}
}