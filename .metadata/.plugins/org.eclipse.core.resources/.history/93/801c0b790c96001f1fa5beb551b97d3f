<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">

<head>
	<title>Mutxamel Club de Fútbol</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<link th:href="@{/css/estilos.css}" rel="stylesheet">
	<link rel="icon" href="/images/favicon.ico" type="image/x-icon">
	<link href="https://fonts.googleapis.com/css2?family=Fredericka+the+Great&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css">
</head>

<body>

	<!-- Incluir el header -->
	<div th:replace="~{cabecera.html}"></div>

	<h1 class="text-center mt-5">Calendario / Resultados</h1>

	<form method="post" action="/admin/calendario-resultados/actualizar">
		<table>
			<thead>
				<tr>
					<th class="hidden">CATEGORIA</th>
					<th>EQUIPO</th>
					<th>RESULTADO</th>
					<th>RIVAL</th>
					<th>DÍA</th>
					<th>HORA</th>
					<th>CAMPO</th>
					<th>ACCIONES</th>
				</tr>
			</thead>
			<tbody>
				<!-- Iteramos sobre la lista de resultados -->
				<tr th:each="resultado, iterStat : ${resultados}">
					<form th:action="@{/admin/calendario-resultados/actualizar/{equipo}(equipo=${resultado.equipo})}"
						method="post">
						<td>
							<input type="text" th:value="${resultado.campo}" name="campo" class="form-control hidden" />
						</td>
						<td>
							<input type="text" th:value="${resultado.equipo}" name="equipo" readonly
								class="form-control" />
						</td>
						<td>
							<input type="text" th:value="${resultado.resultado}" name="resultado"
								class="form-control" />
						</td>
						<td>
							<input type="text" th:value="${resultado.rival}" name="rival" class="form-control" />
						</td>
						<td>
							<input type="text" th:value="${resultado.dia}" name="dia" class="form-control" />
						</td>
						<td>
							<input type="text" th:value="${resultado.hora}" name="hora" class="form-control" />
						</td>
						<td>
							<input type="text" th:value="${resultado.campo}" name="campo" class="form-control" />
						</td>
						<td>
							<button type="submit" class="btn btn-primary">Actualizar</button>
						</td>
					</form>
				</tr>
			</tbody>
		</table>
	</form>



	<!-- Incluir el footer -->
	<div th:replace="~{footer.html}"></div>

	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>