	@PostMapping("/login")
	@ResponseBody
	public Usuario login(@RequestBody UsuarioDTO loginRequest) {
		// Validar el usuario
		Usuario usuario = userService.validarUsuario(loginRequest.getUsername(), loginRequest.getPassword());

		if (usuario != null) {
			// Si la autenticación es exitosa, retornar el usuario
			return usuario;
		} else {
			// Si falla, retorna null o lanza una excepción (puedes personalizar esto)
			return null;
		}
	}

