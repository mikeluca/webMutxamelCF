@Repository
public class EquipoDaoImpl implements EquipoDao {

	private final JdbcTemplate jdbcTemplate;

	public EquipoDaoImpl(JdbcTemplate jdbcTemplate) {
		this.jdbcTemplate = jdbcTemplate;
	}

	@Override
	public boolean guardar(Equipo equipo) {
		if (existeEquipo(equipo.getId())) {
			String sql = "UPDATE equipo SET categoria = ?, grupo = ?, orden = ?, nombre = ? WHERE id = ?";

			return (jdbcTemplate.update(sql, equipo.getCategoria(), equipo.getGrupo(), equipo.getOrden(),
					equipo.getNombre(), equipo.getId()) == 1);

		} else {
			String sql = "INSERT INTO equipo (categoria, grupo, orden, nombre) VALUES (?, ?, ?, ?)";

			return (jdbcTemplate.update(sql, equipo.getCategoria(), equipo.getGrupo(), equipo.getOrden(),
					equipo.getNombre()) == 1);
		}
	}

	@SuppressWarnings("deprecation")
	private boolean existeEquipo(Long id) {
		String sql = "SELECT COUNT(*) FROM equipo WHERE categoria = ? AND grupo = ?";

		// Ejecutar la query y obtener el número de jugadores con ese DNI
		Integer count = jdbcTemplate.queryForObject(sql, new Object[] [{ categoria }, { grupo}], Integer.class);

		// Si el count es mayor que 0, significa que existe el jugador
		return count != null && count > 0;
	}

