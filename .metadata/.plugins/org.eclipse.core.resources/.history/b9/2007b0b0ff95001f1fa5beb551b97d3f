	@SuppressWarnings("deprecation")
	@Override
	public Equipo obtenerEquipoPorId(Long id) {
		String sql = "SELECT * FROM equipo WHERE id = ?";

		return jdbcTemplate.queryForObject(sql, new Object[] { id }, new RowMapper<Equipo>() {
			@Override
			public Equipo mapRow(ResultSet rs, int rowNum) throws SQLException {
				Equipo jugador = new Equipo();
				jugador.setId(rs.getLong("id"));
				jugador.setCategoria(rs.getString("categoria"));
				jugador.setGrupo(rs.getString("grupo"));
				jugador.setOrden(rs.getString("orden"));
				jugador.setNombre(rs.getString("nombre"));
				return jugador;
			}
		});
	}

	@Override
	public void eliminarEquipo(Long id) {
		String sql = "DELETE FROM equipo WHERE id = ?";
		jdbcTemplate.update(sql, id);
	}

	@Override
	public List<String> obtenerCategorias() {
		String sql = "SELECT DISTINCT categoria FROM equipo";
		return jdbcTemplate.queryForList(sql, String.class);
	}

	@Override
	public List<Equipo> obtenerTodos() {
		String sql = "SELECT * FROM equipo ORDER BY orden, nombre";

		return jdbcTemplate.query(sql, new RowMapper<Equipo>() {
			@Override
			public Equipo mapRow(ResultSet rs, int rowNum) throws SQLException {
				Equipo jugador = new Equipo();
				jugador.setId(rs.getLong("id"));
				jugador.setCategoria(rs.getString("categoria"));
				jugador.setGrupo(rs.getString("grupo"));
				jugador.setOrden(rs.getString("orden"));
				jugador.setNombre(rs.getString("nombre"));
				return jugador;
			}
		});
	}

	@SuppressWarnings("deprecation")
	@Override
	public List<Equipo> obtenerTodosPorCategoria(String categoria) {
		String sql = "SELECT * FROM equipo WHERE categoria = ? ORDER BY orden, nombre";

		return jdbcTemplate.query(sql, new Object[] { categoria }, new RowMapper<Equipo>() {
			@Override
			public Equipo mapRow(ResultSet rs, int rowNum) throws SQLException {
				Equipo jugador = new Equipo();
				jugador.setId(rs.getLong("id"));
				jugador.setCategoria(rs.getString("categoria"));
				jugador.setGrupo(rs.getString("grupo"));
				jugador.setOrden(rs.getString("orden"));
				jugador.setNombre(rs.getString("nombre"));
				return jugador;
			}
		});
	}

