package com.mikedev.mutxamelcf.mvc.config;

import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.security.authentication.AuthenticationManager;
import org.springframework.security.config.annotation.authentication.builders.AuthenticationManagerBuilder;
import org.springframework.security.config.annotation.web.builders.HttpSecurity;
import org.springframework.security.config.annotation.web.configuration.EnableWebSecurity;
import org.springframework.security.web.SecurityFilterChain;
import org.springframework.security.web.authentication.LoginUrlAuthenticationEntryPoint;

@Configuration
@EnableWebSecurity
public class SecurityConfig {

	@Bean
	public AuthenticationManager authManager(HttpSecurity http) throws Exception {
		AuthenticationManagerBuilder authenticationManagerBuilder = http
				.getSharedObject(AuthenticationManagerBuilder.class);
		// Configura aquí tu AuthenticationProvider
		authenticationManagerBuilder.authenticationProvider(customAuthenticationProvider());
		return authenticationManagerBuilder.build();
	}

	@Bean
	public CustomAuthenticationProvider customAuthenticationProvider() {
		return new CustomAuthenticationProvider();
	}

	@Bean
	public SecurityFilterChain securityFilterChain(HttpSecurity http) throws Exception {
		http.authorizeHttpRequests(authorize -> authorize.requestMatchers("/", "/css/**", "/images/**").permitAll() // Permitir
																													// acceso
																													// a
																													// login
																													// y
																													// recursos
																													// estáticos
				.requestMatchers("/admin/**").authenticated() // Proteger el menú secreto
				.anyRequest().permitAll() // Requiere autenticación para cualquier otra solicitud
		).formLogin(
				form -> form.loginPage("/login").defaultSuccessUrl("/admin/admin", true).failureUrl("/login?error=true") // Redirige
																															// a
																															// la
																															// página
																															// de
																															// login
																															// con
																															// el
																															// parámetro
																															// "error"
						.permitAll() // Permitir acceso a la página de login
		).logout(logout -> logout.logoutUrl("/logout") // URL para cerrar sesión
				.logoutSuccessUrl("/index") // Redirigir a la página de login después de cerrar sesión
				.invalidateHttpSession(true) // Invalidar sesión HTTP
				.clearAuthentication(true) // Limpiar la autenticación
				.permitAll() // Permitir que cualquier usuario pueda cerrar sesión
		).exceptionHandling(
				exception -> exception.authenticationEntryPoint(new LoginUrlAuthenticationEntryPoint("/login")) // Redirigir
																												// a
																												// login
																												// si no
																												// autenticado
		);

		return http.build();
	}

