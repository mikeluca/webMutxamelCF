<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">

<head>
	<title>Mutxamel Club de Fútbol</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<link th:href="@{/css/estilos.css}" rel="stylesheet">
	<link rel="icon" href="/images/favicon.ico" type="image/x-icon">
	<link href="https://fonts.googleapis.com/css2?family=Fredericka+the+Great&display=swap" rel="stylesheet">
</head>

<style>
	/* CSS para el diseño en tres columnas */
	.container {
		display: flex;
		gap: 20px;
		padding: 20px;
	}

	.column {
		flex: 1;
		background-color: #f9f9f9;
		border: 1px solid #ddd;
		border-radius: 8px;
		padding: 15px;
	}

	.column h2 {
		font-size: 1.2em;
		color: #333;
		text-align: center;
	}

	.team-name {
		font-size: 1em;
		color: #555;
		margin: 5px 0;
		text-align: center;
	}
</style>

<body>

	<!-- Incluir el header -->
	<div th:replace="~{cabecera.html}"></div>

	<main>
		<div class="container">

			<h1>Lista de Equipos por Categoría</h1>

			<!-- Itera sobre el mapa de categorías -->
			<div th:each="entry : ${equiposPorCategoria}">
				<!-- Muestra el nombre de la categoría -->
				<h2 th:text="${entry.key}">Categoría</h2>

				<!-- Tabla para listar equipos de la categoría actual -->
				<table>
					<thead>
						<tr>
							<th>Nombre</th>
						</tr>
					</thead>
					<tbody>
						<!-- Itera sobre la lista de equipos dentro de cada categoría -->
						<tr th:each="equipo : ${entry.value}">
							<td th:text="${equipo.nombre}">Nombre</td>
						</tr>
					</tbody>
				</table>
			</div>

		</div>
	</main>

	<!-- Incluir el footer -->
	<div th:replace="~{footer.html}"></div>

	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>