<body>

	<!-- Incluir el header -->
	<div th:replace="~{cabecera.html}"></div>

	<main>

		<div class="container">
			<h1 class="text-center my-4">Lista de Equipos</h1>

			<!-- Agrupación de equipos por categoría -->
			<div th:each="entry : ${equiposPorCategoria}">
				<div class="category-header">
					<h2 th:text="${entry.key}">Categoría</h2>
				</div>

				<div class="card-columns">
					<!-- Tarjeta para cada equipo -->
					<div th:each="equipo : ${entry.value}" class="card team-card">
						<div class="card-body">
							<h5 class="card-title" th:text="${equipo.nombre}">Nombre del Equipo</h5>
							<p class="card-text" th:text="'Grupo: ' + ${equipo.grupo}">Grupo</p>
							<p class="card-text" th:text="'Orden: ' + ${equipo.orden}">Orden</p>
						</div>
					</div>
				</div>
			</div>
		</div>

