<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">

<head>
	<title>Mutxamel Club de Fútbol - Resultados</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
	<div class="container mt-5">
		<h2 class="text-center">Calendario / Resultados</h2>

		<!-- Formulario para actualizar resultados -->
		<form method="post" th:action="@{/admin/actualizarResultado}">
			<table class="table table-bordered mt-4">
				<thead>
					<tr>
						<th>CATEGORÍA</th>
						<th>RESULTADO</th>
						<th>RIVAL</th>
						<th>DÍA</th>
						<th>HORA</th>
						<th>CAMPO</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					<!-- Iteramos sobre la lista de resultados -->
					<tr th:each="resultado : ${resultados}">
						<td>
							<input type="text" th:field="*{categoria}" th:value="${resultado.categoria}" readonly
								class="form-control" />
						</td>
						<td>
							<input type="text" th:field="*{resultado}" th:value="${resultado.resultado}"
								class="form-control" />
						</td>
						<td>
							<input type="text" th:field="*{rival}" th:value="${resultado.rival}" class="form-control" />
						</td>
						<td>
							<input type="date" th:field="*{dia}"
								th:value="${#dates.format(resultado.dia, 'dd/MM/yyyy')}" class="form-control" />
						</td>
						<td>
							<input type="text" th:field="*{hora}" th:value="${resultado.hora}" class="form-control" />
						</td>
						<td>
							<input type="text" th:field="*{campo}" th:value="${resultado.campo}" class="form-control" />
						</td>
						<td>
							<button type="submit"
								formaction="@{/admin/actualizarResultado/{categoria}(categoria=${resultado.categoria})}"
								class="btn btn-primary">Actualizar</button>
						</td>
					</tr>
				</tbody>
			</table>

			<!-- Botón para enviar el formulario -->
			<div class="text-center mt-3">
				<button type="submit" class="btn btn-primary">Actualizar</button>
			</div>
		</form>
	</div>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>