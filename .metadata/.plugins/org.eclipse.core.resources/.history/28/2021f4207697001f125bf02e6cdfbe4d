	<!-- Modal para crear/editar jugador -->
	<div class="modal fade lead" id="equipoModal" tabindex="-1" role="dialog" aria-labelledby="equipoModalLabel"
		aria-hidden="true">
		<div class="modal-dialog modal-lg" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h3 class="modal-title lead" id="equipoModalLabel">Nuevo Equipo</h3>
					<button type="button" class="close" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>
				<form id="equipoForm" enctype="multipart/form-data" onsubmit="return false;">
					<input type="hidden" th:name="${_csrf.parameterName}" th:value="${_csrf.token}" />
					<div class="modal-body">
						<!-- Mensaje de éxito/error -->
						<div id="mensajeModal" class="alert" style="display:none; margin: 10px;"></div>
						<div class="form-group">
							<label for="categoria">Categoría:</label>
							<select id="cate" name="categoria" class="form-control">
								<option th:each="categoria : ${categorias}" th:value="${categoria}"
									th:text="${categoria}"></option>
							</select>
						</div>
						<div class="form-group">
							<label for="grupo">Grupo:</label>
							<select id="grupo" name="grupo" class="form-control">
								<option value="A">A</option>
								<option value="B">B</option>
								<option value="C">C</option>
								<option value="D">D</option>
								<option value="E">E</option>
								<option value="Fem">Fem</option>
								<option value="Vet">Vet</option>
							</select>
						</div>
						<div class="form-group">
							<label for="nombre">Nombre:</label>
							<input type="text" class="form-control" id="nombre" name="nombre" readonly>
						</div>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
						<button type="submit" class="btn btn-primary" onclick="guardarEquipo()">Guardar Cambios</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<!-- Incluir el footer -->
	<div th:replace="~{admin/footerAdmin.html}"></div>

	<script>
		function guardarEquipo() {
			// Obtén los datos del formulario
			const formData = new FormData(document.getElementById('equipoForm'));

			// Enviar el formulario con AJAX
			fetch('/admin/equipos/guardar', {
				method: 'POST',
				body: formData
			})
				.then(response => {
					if (!response.ok) {
						return response.json().then(errorData => {
							document.getElementById('mensajeModal').className = 'alert alert-danger'; // Establecer clase de error
							document.getElementById('mensajeModal').textContent = errorData.error || 'Error desconocido';
							document.getElementById('mensajeModal').style.display = 'block'; // Mostrar el mensaje
						});
					}
					return response.json();
				})
				.then(data => {
					// Si el equipo se guardó correctamente
					if (data.mensaje) {

						$('#equipoModal').modal('hide');

						/*document.getElementById('mensajeModal').className = 'alert alert-success'; // Establecer clase de éxito
						document.getElementById('mensajeModal').textContent = data.mensaje;
						document.getElementById('mensajeModal').style.display = 'block'; // Mostrar el mensaje*/

						/*setTimeout(() => {*/
						/*$('#equipoModal').modal('hide'); // Cerrar modal después de un tiempo*/
						/*	}, 1000); // Esperar 2 segundos antes de cerrar*/
					}
				})
				.catch(error => {
					console.error('Error:', error);
				});
		}

		function limpiarFormulario() {
			document.getElementById('cate').value = '';
			document.getElementById('nombre').value = '';
			document.getElementById('grupo').value = '';
			document.getElementById('equipoModalLabel').textContent = 'Nuevo Equipo';
			document.getElementById('mensajeModal').style.display = 'none'; // Limpiar mensaje
		}

		// Función para actualizar el campo "nombre"
		function actualizarNombre() {
			const categoria = document.getElementById('cate').value;
			const grupo = document.getElementById('grupo').value;
			document.getElementById('nombre').value = categoria + ' ' + grupo;
		}

		document.getElementById('cate').addEventListener('change', actualizarNombre);
		document.getElementById('grupo').addEventListener('change', actualizarNombre);
	</script>

