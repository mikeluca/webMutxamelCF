				new Jugador("Juan Pérez", "Delantero", 9, "man.png"),
				new Jugador("Carlos García", "Portero", 1, "girl.png"),
				new Jugador("Juan Pérez", "Delantero", 9, "man.png"),
				new Jugador("Carlos García", "Portero", 1, "girl.png"),
