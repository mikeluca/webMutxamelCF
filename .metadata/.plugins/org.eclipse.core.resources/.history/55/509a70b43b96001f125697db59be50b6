<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">

<head>
	<title>Mutxamel Club de Fútbol</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<link th:href="@{/css/estilos.css}" rel="stylesheet">
	<link rel="icon" href="/images/favicon.ico" type="image/x-icon">
	<link href="https://fonts.googleapis.com/css2?family=Fredericka+the+Great&display=swap" rel="stylesheet">
</head>

<body>

	<!-- Incluir el header -->
	<div th:replace="~{cabecera.html}"></div>

	<main>
		<div class="container">

			<h1>Lista de Equipos por Categoría</h1>

			<!-- Itera sobre el mapa de categorías -->
			<div th:each="entry : ${equiposPorCategoria}">
				<!-- Muestra el nombre de la categoría -->
				<h2 th:text="${entry.key}">Categoría</h2>

				<!-- Tabla para listar equipos de la categoría actual -->
				<table>
					<thead>
						<tr>
							<th>ID</th>
							<th>Nombre</th>
							<th>Grupo</th>
							<th>Orden</th>
						</tr>
					</thead>
					<tbody>
						<!-- Itera sobre la lista de equipos dentro de cada categoría -->
						<tr th:each="equipo : ${entry.value}">
							<td th:text="${equipo.id}">ID</td>
							<td th:text="${equipo.nombre}">Nombre</td>
							<td th:text="${equipo.grupo}">Grupo</td>
							<td th:text="${equipo.orden}">Orden</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!--			<h1>Equipos por Categoría</h1>-->

			<!--			<div th:each="categoria, equipos : ${equiposPorCategoria}">-->
			<!--				<h2 th:text="${categoria}">Categoría</h2>-->
			<!--				<table class="table table-striped">-->
			<!--					<thead>-->
			<!--						<tr>-->
			<!--							<th>Nombre del Equipo</th>-->
			<!--						</tr>-->
			<!--					</thead>-->
			<!--					<tbody>-->
			<!--						<tr th:each="equipo : ${equipos}">-->
			<!--							<td th:text="${equipo.nombre}">Nombre del Equipo</td>-->
			<!--						</tr>-->
			<!--					</tbody>-->
			<!--				</table>-->
			<!--			</div>-->
		</div>
	</main>

	<!-- Incluir el footer -->
	<div th:replace="~{footer.html}"></div>

	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>