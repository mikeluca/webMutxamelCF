package com.mikedev.mutxamelcf.mvc.controller;

import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.ModelAttribute;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.multipart.MultipartFile;
import org.springframework.web.util.HtmlUtils;

import com.mikedev.mutxamelcf.model.CuerpoTecnicoDTO;
import com.mikedev.mutxamelcf.model.EquipoDTO;
import com.mikedev.mutxamelcf.model.JugadorDTO;
import com.mikedev.mutxamelcf.model.NoticiaDTO;
import com.mikedev.mutxamelcf.model.ResultadoDTO;
import com.mikedev.mutxamelcf.service.CuerpoTecnicoService;
import com.mikedev.mutxamelcf.service.EquipoService;
import com.mikedev.mutxamelcf.service.JugadorService;
import com.mikedev.mutxamelcf.service.NoticiaService;
import com.mikedev.mutxamelcf.service.ResultadoService;

@Controller
@RequestMapping("/admin")
public class AdminController {

	@Autowired
	private JugadorService jugadoresService;

	@Autowired
	private CuerpoTecnicoService cuerpoTecnicoService;

	@Autowired
	private NoticiaService noticiaService;

	@Autowired
	private ResultadoService resultadoService;

	@Autowired
	private EquipoService equiposService;

	// Mostrar la lista de jugadores con filtro
	@GetMapping("/equipos")
	public String listarEquipos(@RequestParam(required = false) String categoria, Model model) {
		List<EquipoDTO> listaEquipos = equiposService.obtenerTodos();
		model.addAttribute("listaEquipos", listaEquipos);
		List<String> categorias = equiposService.obtenerCategorias();
		List<EquipoDTO> equipos;
		if (categoria != null && !categoria.isEmpty()) {
			equipos = equiposService.obtenerTodosPorCategoria(categoria);
		} else {
			equipos = equiposService.obtenerTodos();

		}

		model.addAttribute("categorias", categorias);
		model.addAttribute("equipos", equipos);
		return "admin/equipos";
	}

	@PostMapping("/equipos/guardar")
	public String guardarEquipo(@RequestParam String categoria, @RequestParam String nombre,
			@RequestParam String grupo) {
		try {
			EquipoDTO equipo = new EquipoDTO();
			equipo.setCategoria(categoria);
			equipo.setNombre(nombre);
			equipo.setGrupo(grupo);

			// Llamar al servicio para guardar el equipo
			equiposService.guardar(equipo);

			return "redirect:/admin/equipos";
		} catch (Exception e) {
			return "redirect:/admin/equipos";

		}
	}

	// Borrar jugador
	@PostMapping("/equipos/borrar/{id}")
	public String borrarEquipo(@PathVariable Long id) {
		equiposService.eliminarEquipo(id);
		return "redirect:/admin/equipos";
	}

	// Mostrar la lista de jugadores con filtro
	@GetMapping("/jugadores")
	public String listarJugadores(@RequestParam(required = false) String categoria, Model model) {
		List<EquipoDTO> listaEquipos = equiposService.obtenerTodos();
		model.addAttribute("listaEquipos", listaEquipos);
		List<JugadorDTO> jugadores;
		if (categoria != null && !categoria.isEmpty()) {
			jugadores = jugadoresService.obtenerJugadoresPorCategoria(categoria);
		} else {
			jugadores = jugadoresService.obtenerTodos();

		}

		List<String> categorias = equiposService.obtenerCategorias();
		model.addAttribute("categorias", categorias);
		model.addAttribute("jugadores", jugadores);
		return "admin/jugadores";
	}

	@PostMapping("/jugadores/guardar")
	public String guardarJugador(@RequestParam String nombre, @RequestParam String apellidos,
			@RequestParam String fechaNacimiento, @RequestParam String categoria, @RequestParam String dni,
			@RequestParam String equipo, @RequestParam int dorsal, @RequestParam String posicion,
			@RequestParam MultipartFile foto) {
		try {
			JugadorDTO jugador = new JugadorDTO();
			jugador.setDni(dni);
			jugador.setNombre(nombre);
			jugador.setApellidos(apellidos);

			SimpleDateFormat formatter = new SimpleDateFormat("yyyy-MM-dd");
			Date fechaNacimientoDate = formatter.parse(fechaNacimiento);
			jugador.setFechaNacimiento(fechaNacimientoDate);

			jugador.setCategoria(categoria);
			jugador.setEquipo(equipo);
			jugador.setDorsal(dorsal);
			jugador.setPosicion(posicion);

			// Si hay una foto cargada, la convertimos a byte[]
			if (!foto.isEmpty()) {
				jugador.setFoto(foto.getBytes());
			}

			// Llamar al servicio para guardar el jugador
			jugadoresService.guardarJugador(jugador);

			return "redirect:/admin/jugadores";
		} catch (Exception e) {
			return "redirect:/admin/jugadores";

		}
	}

	// Borrar jugador
	@PostMapping("/jugadores/borrar/{dni}")
	public String borrarJugador(@PathVariable String dni) {
		jugadoresService.eliminarJugador(dni);
		return "redirect:/admin/jugadores";
	}

	// Mostrar la lista de staff con filtro
	@GetMapping("/cuerpo-tecnico")
	public String listarCuerpoTecnico(@RequestParam(required = false) String categoria, Model model) {
		List<EquipoDTO> listaEquipos = equiposService.obtenerTodos();
		model.addAttribute("listaEquipos", listaEquipos);
		List<CuerpoTecnicoDTO> cuerpoTecnico;
		if (categoria != null && !categoria.isEmpty()) {
			cuerpoTecnico = cuerpoTecnicoService.obtenerCuerpoTecnicoPorCategoria(categoria);
		} else {
			cuerpoTecnico = cuerpoTecnicoService.obtenerTodos();

		}

		List<String> categorias = equiposService.obtenerCategorias();
		model.addAttribute("categorias", categorias);
		model.addAttribute("cuerpoTecnico", cuerpoTecnico);
		return "admin/cuerpo-tecnico";
	}

	@PostMapping("/cuerpo-tecnico/guardar")
	public String guardarCuerpoTecnico(@RequestParam String nombre, @RequestParam String apellidos,
			@RequestParam String fechaNacimiento, @RequestParam String categoria, @RequestParam String dni,
			@RequestParam String equipo, @RequestParam String puesto, @RequestParam MultipartFile foto) {
		try {
			CuerpoTecnicoDTO staff = new CuerpoTecnicoDTO();
			staff.setDni(dni);
			staff.setNombre(nombre);
			staff.setApellidos(apellidos);

			SimpleDateFormat formatter = new SimpleDateFormat("yyyy-MM-dd");
			Date fechaNacimientoDate = formatter.parse(fechaNacimiento);
			staff.setFechaNacimiento(fechaNacimientoDate);

			staff.setCategoria(categoria);
			staff.setEquipo(equipo);
			staff.setPuesto(puesto);

			// Si hay una foto cargada, la convertimos a byte[]
			if (!foto.isEmpty()) {
				staff.setFoto(foto.getBytes());
			}

			// Llamar al servicio para guardar el cuerpo tecnico
			cuerpoTecnicoService.guardarCuerpoTecnico(staff);

			return "redirect:/admin/cuerpo-tecnico";
		} catch (Exception e) {
			return "redirect:/admin/cuerpo-tecnico";

		}
	}

	// Borrar cuerpo tecnico
	@PostMapping("/cuerpo-tecnico/borrar/{dni}")
	public String borrarCuerpoTecnico(@PathVariable String dni) {
		cuerpoTecnicoService.eliminarCuerpoTecnico(dni);
		return "redirect:/admin/cuerpo-tecnico";
	}

	// Mostrar la lista de noticias
	@GetMapping("/noticias")
	public String listarNoticias(Model model) {
		List<EquipoDTO> listaEquipos = equiposService.obtenerTodos();
		model.addAttribute("listaEquipos", listaEquipos);
		List<NoticiaDTO> listaNoticias = noticiaService.obtenerTodas();
		List<String> categorias = equiposService.obtenerCategorias();
		model.addAttribute("categorias", categorias);
		model.addAttribute("listaNoticias", listaNoticias);
		return "admin/noticias";
	}

	@PostMapping("/noticias/guardar")
	public String guardarNoticia(@RequestParam String titulo, @RequestParam String contenido,
			@RequestParam MultipartFile imagen, Model model) {
		try {
			NoticiaDTO noticia = new NoticiaDTO();
			noticia.setTitulo(titulo);

			// Convierte el texto antes de guardarlo poniendole saltos de línea
			String contenidoConSaltos = HtmlUtils.htmlEscape(contenido).replaceAll("\n", "<br>");
			noticia.setContenido(contenidoConSaltos);
			noticia.setFecha(new Date());

			// Si hay una foto cargada, la convertimos a byte[]
			if (!imagen.isEmpty()) {
				noticia.setImagen(imagen.getBytes());
			}

			// Llamar al servicio para guardar la noticia
			noticiaService.guardarNoticia(noticia);

			return "redirect:/admin/noticias";
		} catch (Exception e) {
			return "redirect:/admin/noticias";
		}
	}

	// Borrar cuerpo tecnico
	@PostMapping("/noticias/borrar/{id}")
	public String borrarNoticia(@PathVariable int id) {
		noticiaService.eliminarNoticia(id);
		return "redirect:/admin/noticias";
	}

	// Mostrar la lista de calendario-resultados
	@GetMapping("/calendario-resultados")
	public String listarResultados(Model model) {
		List<EquipoDTO> listaEquipos = equiposService.obtenerTodos();
		model.addAttribute("listaEquipos", listaEquipos);
		// Obtener todos los resultados desde la base de datos
		List<ResultadoDTO> resultados = resultadoService.obtenerResultados();
		List<String> categorias = equiposService.obtenerCategorias();
		model.addAttribute("categorias", categorias);
		model.addAttribute("resultados", resultados);
		return "admin/calendario-resultados";

	}

	@PostMapping("/calendario-resultados/actualizar")
	public String actualizarResultados(@ModelAttribute("resultados") List<ResultadoDTO> resultadosActualizados) {
		for (ResultadoDTO resultado : resultadosActualizados) {
			resultadoService.actualizarResultado(resultado);
		}
		return "redirect:/admin/calendario-resultados"; // Redirige de nuevo a la página después de la actualización
	}

}
