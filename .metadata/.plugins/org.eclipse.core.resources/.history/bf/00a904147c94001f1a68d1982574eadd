<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">

<head>
	<title>Mutxamel Club de Fútbol</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<link th:href="@{/css/estilos.css}" rel="stylesheet">
	<link rel="icon" href="/images/favicon.ico" type="image/x-icon">
	<link href="https://fonts.googleapis.com/css2?family=Fredericka+the+Great&display=swap" rel="stylesheet">
</head>

<body>

	<!-- Incluir el header -->
	<div th:replace="~{cabecera.html}"></div>

	<main class="container my-5">
		<h2 class="text-center mb-5">Jugadores - <span th:text="${categoria}"></h2>
		<div class="personas-grid">
			<div class="card h-100" th:each="jugador : ${jugadores}">
				<img th:src="@{/images/{foto}(foto=${jugador.foto ?: 'man.png'})}" class="card-img-top persona-img"
					alt="Imagen Jugador">
				<div class="card-body">
					<h2 class="card-title" th:text="${jugador.nombre} + ' ' + ${jugador.apellidos}"></h2>
					<p class="card-text lead">
						<span th:text="${jugador.dorsal}"></span> - <span th:text="${jugador.posicion}"></span>
					</p>
				</div>
			</div>
		</div>

		<h2 class="text-center m-5">Cuerpo Técnico</h2>
		<div class="personas-grid">
			<div class="card h-100" th:each="staff : ${staff}">
				<img th:src="@{/images/{foto}(foto=${staff.foto ?: 'office-man.png'})}" class="card-img-top persona-img"
					alt="Imagen Staff">
				<div class="card-body">
					<h3 class="card-title" th:text="${staff.nombre} + ' ' + ${staff.apellidos}"></h3>
					<p class="card-text" th:text="${staff.puesto}"></p>
				</div>
			</div>
		</div>
	</main>

	<!-- Incluir el footer -->
	<div th:replace="~{footer.html}"></div>

	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>