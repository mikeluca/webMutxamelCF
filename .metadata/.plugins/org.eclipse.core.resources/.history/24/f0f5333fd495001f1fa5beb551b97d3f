<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">

<head>
	<title>Mutxamel Club de Fútbol - Resultados</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
	<div class="container mt-5">
		<h2 class="text-center">Calendario / Resultados</h2>

		<!-- Formulario para actualizar resultados -->
		<form method="post" th:action="@{/admin/calendario-resultados/actualizar}">
			<table class="table table-bordered mt-4">
				<thead>
					<tr>
						<th>CATEGORÍA</th>
						<th>RESULTADO</th>
						<th>RIVAL</th>
						<th>DÍA</th>
						<th>HORA</th>
						<th>CAMPO</th>
					</tr>
				</thead>
				<tbody>
					<!-- Iteramos sobre la lista de resultados -->
					<tr th:each="resultado, iterStat : ${resultados}">
						<td>
							<input type="text" th:value="${resultado.categoria}"
								name="resultados[__${iterStat.index}__].categoria" readonly class="form-control" />
						</td>
						<td>
							<input type="text" th:value="${resultado.resultado}"
								name="resultados[__${iterStat.index}__].resultado" class="form-control" />
						</td>
						<td>
							<input type="text" th:value="${resultado.rival}"
								name="resultados[__${iterStat.index}__].rival" class="form-control" />
						</td>
						<td>
							<input type="date" th:value="${#dates.format(resultado.dia, 'yyyy-MM-dd')}"
								name="resultados[__${iterStat.index}__].dia" class="form-control" />
						</td>
						<td>
							<input type="text" th:value="${resultado.hora}"
								name="resultados[__${iterStat.index}__].hora" class="form-control" />
						</td>
						<td>
							<input type="text" th:value="${resultado.campo}"
								name="resultados[__${iterStat.index}__].campo" class="form-control" />
						</td>
					</tr>
				</tbody>
			</table>

			<!-- Botón para enviar el formulario -->
			<div class="text-center mt-3">
				<button type="submit" class="btn btn-primary">Actualizar</button>
			</div>
		</form>
	</div>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>