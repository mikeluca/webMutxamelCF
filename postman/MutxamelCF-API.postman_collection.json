      "item": [
        {
          "name": "Crear comunicación",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Aviso de entrenamiento\",\n  \"contenido\": \"Se adelanta el entrenamiento del jueves a las 18:00.\",\n  \"equipoIds\": [{{equipoId}}],\n  \"categorias\": [],\n  \"destinatariosIds\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/app/comunicaciones",
              "host": ["{{baseUrl}}"],
              "path": ["app", "comunicaciones"]
            },
            "description": "Se puede dirigir por equipoIds, categorias o destinatariosIds (usuarios concretos, ver endpoint 'Destinatarios directos'), nunca combinando varios modos. 403 si no tienes permiso para comunicar con el público elegido."
          }
        },
        {
          "name": "Enviar mensaje privado (chat)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
