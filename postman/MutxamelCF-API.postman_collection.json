    {
      "name": "Convocatorias",
      "description": "Gestión de convocatorias de partido. Requiere que el usuario autenticado pueda gestionar el equipo indicado (rol entrenador/coordinador sobre ese equipo).",
      "item": [
        {
          "name": "Crear convocatoria",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipoId\": {{equipoId}},\n  \"rival\": \"CD Rival\",\n  \"campo\": \"Campo Municipal\",\n  \"fechaPartido\": \"2026-10-05\",\n  \"horaPartido\": \"17:00\",\n  \"horaConvocatoria\": \"16:00\",\n  \"lugarConvocatoria\": \"Vestuarios\",\n  \"jugadoresIds\": [{{jugadorId}}]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/app/convocatorias",
              "host": ["{{baseUrl}}"],
              "path": ["app", "convocatorias"]
            },
            "description": "201 al crear. 400 si faltan campos, ya existe convocatoria ese día para el equipo, o algún jugador no pertenece al equipo. 403 si no gestionas el equipo."
          }
        },
        {
          "name": "Actualizar convocatoria",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipoId\": {{equipoId}},\n  \"rival\": \"CD Rival\",\n  \"campo\": \"Campo Municipal (cambio)\",\n  \"fechaPartido\": \"2026-10-05\",\n  \"horaPartido\": \"18:00\",\n  \"horaConvocatoria\": \"17:00\",\n  \"lugarConvocatoria\": \"Vestuarios\",\n  \"jugadoresIds\": [{{jugadorId}}]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/app/convocatorias/{{convocatoriaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["app", "convocatorias", "{{convocatoriaId}}"]
            },
            "description": "El equipo no se puede cambiar ni tampoco los jugadores convocados (el servicio los ignora si se envían); solo se actualizan los datos del partido."
          }
        },
        {
          "name": "Obtener convocatoria por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/app/convocatorias/{{convocatoriaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["app", "convocatorias", "{{convocatoriaId}}"]
            }
          }
        },
        {
          "name": "Listar convocatorias de un equipo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/app/convocatorias?equipoId={{equipoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["app", "convocatorias"],
              "query": [{ "key": "equipoId", "value": "{{equipoId}}" }]
            }
          }
        },
        {
          "name": "Eliminar convocatoria",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/app/convocatorias/{{convocatoriaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["app", "convocatorias", "{{convocatoriaId}}"]
            },
            "description": "204 sin contenido si se elimina correctamente."
          }
        }
      ]
    },
